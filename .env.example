# Copy to .env (git-ignored) and fill in. Used by tools/tts/voice.py.
# Azure AI Speech: portal.azure.com -> create "Speech service", pricing tier Free F0 -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional: force a provider for every film (azure | edge). Default: Azure when the key is set, else Edge.
# TTS_PROVIDER=
